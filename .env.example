APP_NAME="ULTRON-B AI"
# PRODUCTION: set to production
APP_ENV=local
# Run: php artisan key:generate
APP_KEY=
# PRODUCTION: set to false
APP_DEBUG=true
# PRODUCTION: set to your HTTPS domain, e.g. https://app.yourdomain.com
APP_URL=http://localhost
APP_PORT=80
APP_SSL_PORT=443

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# PRODUCTION: use single or stderr; avoid debug level
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# PRODUCTION: set to error or warning
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=ultron-mysql
DB_PORT=3306
DB_DATABASE=ultron
# PRODUCTION: use a strong, unique password
DB_USERNAME=ultron
DB_PASSWORD=password
DB_ROOT_PASSWORD=rootsecret
# PRODUCTION: do not expose MySQL port publicly; set to 127.0.0.1:3306 or remove
DB_EXTERNAL_PORT=3306

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUCTION: set to true when serving over HTTPS
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=ultron_

REDIS_CLIENT=phpredis
REDIS_HOST=ultron-redis
# PRODUCTION: set a strong Redis password and enable requirepass in redis config
REDIS_PASSWORD=null
REDIS_PORT=6379
# PRODUCTION: do not expose Redis port publicly; remove or bind to 127.0.0.1
REDIS_EXTERNAL_PORT=6379

# PRODUCTION: configure a real mailer (smtp, mailgun, ses, postmark)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@ultron.ai"
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth (Analytics + Search Console)
# Required for live OAuth. Without these, a pending placeholder is created only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678
N8N_SIGNING_SECRET=
# PRODUCTION: replace with a securely generated 32+ character key (never use the default)
N8N_ENCRYPTION_KEY=changeme-32-char-minimum-key-here

# n8n Database
N8N_DB_DATABASE=n8n
N8N_DB_USER=n8n
# PRODUCTION: use a strong, unique password
N8N_DB_PASSWORD=n8npassword

VITE_APP_NAME="${APP_NAME}"
