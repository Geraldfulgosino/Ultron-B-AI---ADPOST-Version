# adpost-web environment (copy to .env.local; never commit real values)

# "mock" = in-browser simulated backend (default). "supabase" = Supabase staging.
# (Deprecated alias: VITE_BACKEND=local means mock.)
VITE_DATA_PROVIDER=mock

# Public Supabase settings. The publishable key is public by design (RLS protects data).
# The app only accepts the authorized staging project (src/data/supabase/config.ts).
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Never put secret/service-role keys, database passwords or model provider keys
# (Anthropic/OpenAI) in VITE_* variables. They belong in Supabase Edge Function secrets only.
