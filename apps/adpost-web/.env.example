# adpost-web environment (copy to .env.local; never commit real values)

# "local" = in-browser simulated backend (default, the only option before Phase 17)
VITE_BACKEND=local

# Phase 17 only. The Supabase anon key is public by design (RLS protects data),
# but keep the project URL/key out of git until the owner authorizes integration.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Never put model provider keys (Anthropic/OpenAI) in VITE_* variables.
# They belong in Supabase Edge Function secrets only.
